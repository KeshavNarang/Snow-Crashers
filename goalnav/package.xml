<?xml version="1.0"?>
<package format="3">
  <name>drone_ref</name><version>0.2.0</version>
  <description>Goal navigation on a live map for the DroneHacks course (Sky Beta), not flight-qualified.</description>
  <maintainer email="snowcrashers@example.invalid">SnowCrashers</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>px4_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend><exec_depend>message_filters</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>skybeta_flight_interface</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
