#!/usr/bin/env bash
# One command per stage to fly goalnav on OUR drone (skybeta-03). Plain steps: FLYING.md.
#   tools/fly deploy "<your name>"   lock, copy goalnav + scripts, make sure the camera runs RGBSTEREO
#                                    (builds the team camera image if not), pick the goalnav mission (asks sudo)
#                                    -> then power-cycle the drone (battery out 10 s, in, wait ~3 min)
#   tools/fly check                  both health checks: the organizers' doctor, then our pre-flight
#                                    (props off, on the launch mark), then goalnav's status
#   tools/fly bench                  goalnav bench check, props off, read-only (~1 min): GO / NO-GO
#   tools/fly logs                   copy the newest flight log folder to ./flight-logs/
#   tools/fly done                   put Luke's overwall_nav back (asks sudo) and release the lock
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"; d="$root/tools/drone"; cd "$root"
# Ask for the drone password once (unless .secrets/skybeta-03.env exists); kept in memory only.
if [ -z "${DRONE_PASS:-}" ] && [ ! -f .secrets/skybeta-03.env ]; then
  read -rsp "skybeta-03 password (user dronehacks, from the organizers): " DRONE_PASS </dev/tty; echo >&2
  export DRONE_PASS
fi
host=$("$d" run hostname)
[ "$host" = "skybeta-03" ] || { echo "STOP: connected to '$host', not skybeta-03. Disconnect."; exit 2; }
in_stack() { "$d" run "docker exec skybeta-stack bash -c \"source skybeta_env.sh >/dev/null 2>&1; $1\""; }
# The camera config the running stack uses (the team image replaces it with team_ws/camera/oakd_vslam.yaml).
CAMERA_CONFIG=/root/skybeta_ws/install/oakd_vslam_bringup/share/oakd_vslam_bringup/config/oakd_vslam.yaml
camera_mode() { "$d" run "docker exec skybeta-stack grep -h -m1 '^[[:space:]]*i_pipeline_type:' $CAMERA_CONFIG 2>/dev/null | awk '{print \$2}'" || true; }
case "${1:-}" in
  deploy)
    who="${2:?usage: tools/fly deploy \"<your name>\"}"
    launch=goalnav.launch.py
    "$root/tools/drone-lock" acquire "$who" "goalnav flight test"
    "$d" run 'mv ~/team_ws/src/drone_ref ~/drone_ref.prev-$(date +%Y%m%d-%H%M%S) 2>/dev/null; true'
    "$d" push goalnav '~/team_ws/src/drone_ref'
    "$d" push team_ws/run_mission.sh '~/team_ws/run_mission.sh'
    "$d" push team_ws/preflight.sh '~/team_ws/preflight.sh'
    "$d" run 'chmod +x ~/team_ws/run_mission.sh ~/team_ws/preflight.sh'
    mode=$(camera_mode)
    if [ "$mode" = "RGBSTEREO" ]; then
      echo "== camera: RGBSTEREO (colour + mono pair) already"
    else
      echo "== camera runs '${mode:-unknown}', not RGBSTEREO: building the team camera image (several minutes)"
      "$d" run 'mkdir -p ~/team_ws/camera'
      "$d" push team_ws/camera/oakd_vslam.yaml '~/team_ws/camera/oakd_vslam.yaml'
      "$d" push team_ws/Dockerfile '~/team_ws/Dockerfile'
      "$d" push team_ws/.dockerignore '~/team_ws/.dockerignore'
      "$d" runt 'cd ~/skybeta && host/run.sh build'
      echo "== camera image built: RGBSTEREO applies at the power-cycle below"
    fi
    echo "== build check (about a minute)"
    in_stack "team_build.sh --packages-select drone_ref"
    echo "== choosing the mission drone_ref/$launch (sudo password = the login password)"
    "$d" runt "~/team_ws/run_mission.sh drone_ref $launch"
    echo; echo "NOW: power-cycle the drone (battery out 10 s, in), wait ~3 min, then: tools/fly check" ;;
  bench)
    "$d" push tools/bench-goalnav.sh '/tmp/bench-goalnav.sh'
    "$d" run 'bash /tmp/bench-goalnav.sh' ;;
  check)
    echo "== 1/3 the organizers' health check (host/doctor.sh)"
    "$d" run 'cd ~/skybeta && host/doctor.sh' || echo "doctor reported a FAIL: read it above before flying"
    echo; echo "== 2/3 our pre-flight (~25 s, keep the drone still)"
    "$d" run '~/team_ws/preflight.sh' || true
    echo; echo "== 3/3 goalnav status (10 s)"
    in_stack "timeout 10 ros2 topic echo --once /goalnav/status" || echo "NO goalnav status: do not fly (redo deploy + power-cycle)"
    echo; echo "Expected with goalnav: pre-flight 'mission' (names drone_ref), 'pad_detect' and 'wall depth rate'"
    echo "(overwall_nav's nodes) FAIL. Everything else, and the doctor, should PASS. Camera must be RGBSTEREO." ;;
  logs)
    last=$("$d" run 'ls -t ~/team_ws/logs | grep -vx overwall | head -1')   # overwall_nav logs to its own subfolder
    mkdir -p flight-logs && "$d" pull "~/team_ws/logs/$last" "flight-logs/" \
      && echo "saved flight-logs/$last; summary: python3 tools/postflight.py flight-logs/$last" ;;
  done)
    "$d" runt '~/team_ws/run_mission.sh overwall_nav overwall.launch.py' || true
    "$root/tools/drone-lock" release ;;
  *) sed -n 2,7p "$0"; exit 1 ;;
esac
